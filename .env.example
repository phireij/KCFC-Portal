# VITE_CLIENT_ID: Required for Google Workspace (Gmail) integration.
# Obtain this from the Google Cloud Console (OAuth 2.0 Client IDs).
VITE_CLIENT_ID=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP E-mail Broadcast variables
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase Cloud Messaging Public VAPID Key for browser notifications
VITE_FCM_VAPID_KEY=

# --- KCFC runtime environment boundary ---
# Normal production-compatible/default behavior is "production".
# For isolated staging/browser/device QA set BOTH runtime markers to "staging" and provide
# complete client + server Firebase env configuration for a DIFFERENT Firebase project.
# Client and server fail closed rather than falling back to the committed production/default project.
VITE_KCFC_RUNTIME_ENV=production
KCFC_RUNTIME_ENV=production

# --- Firebase Client Credentials ---
# Explicit VITE_FIREBASE_* values take precedence over the committed compatibility config.
# Staging must use an isolated Firebase project and must never reuse the committed project ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# --- Firebase Server Credentials ---
# Explicit FIREBASE_* values take precedence over the committed compatibility config.
# In staging these must describe the same isolated staging Firebase project as the client values above.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=

# --- Staging-only governed Core-status transition executor ---
# This must remain OFF by default. The executor is not wired to any production route.
# Future staging activation requires an isolated staging Firebase project and explicit review.
KCFC_CORE_STATUS_STAGING_EXECUTOR_ENABLED=false

# --- Optional communication connectors ---
# IMPORTANT: all external messaging connectors are OFF by default.
# Enabling any connector in production requires an explicit approval gate,
# server-side secret configuration, callback verification and staging validation.
KCFC_CONNECTOR_LINE_ENABLED=false
KCFC_CONNECTOR_TELEGRAM_ENABLED=false
KCFC_CONNECTOR_WHATSAPP_ENABLED=false
KCFC_CONNECTOR_VIBER_ENABLED=false

# Browser-safe availability flags. These reveal only whether the corresponding
# Connect/Disconnect UI may be shown; they never contain provider credentials.
VITE_KCFC_LINE_CONNECTOR_ENABLED=false
VITE_KCFC_TELEGRAM_CONNECTOR_ENABLED=false
VITE_KCFC_WHATSAPP_CONNECTOR_ENABLED=false
VITE_KCFC_VIBER_CONNECTOR_ENABLED=false

# LINE server-side credentials. Never expose these through VITE_* variables.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CALLBACK_URL=

# Telegram server-side credentials. Never expose the bot token through VITE_* variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CALLBACK_SECRET=

# Future / conditional WhatsApp connector credentials.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Future / low-priority Viber connector credentials.
VIBER_BOT_TOKEN=
